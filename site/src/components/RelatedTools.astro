---
// "Tools for this page": links to the tools that help with what the page teaches.
import UiIcon from './UiIcon.astro';
import { RELATED } from '../data/related';

const { id } = Astro.props as { id: string };
const tools = RELATED[id] ?? [];
---

{
  tools.length > 0 && (
    <section class="cp-related not-content" aria-label="Tools for this page" data-pagefind-ignore>
      <h2 class="cp-related__title">Tools for this page</h2>
      <ul class="cp-related__list">
        {tools.map((t) => (
          <li>
            <a class="cp-related__item" href={t.href}>
              <span class="cp-related__icon">
                <UiIcon name={t.icon} />
              </span>
              <span class="cp-related__text">
                <span class="cp-related__label">{t.label}</span>
                <span class="cp-related__hint">{t.hint}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .cp-related {
    margin-top: 3rem;
  }
  .cp-related__title {
    margin: 0 0 0.75rem;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cp-related__list {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .cp-related__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    height: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius);
    background: var(--cp-card);
    color: var(--sl-color-white);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .cp-related__item:hover {
    border-color: var(--sl-color-accent);
    background: var(--cp-card-hover);
  }
  .cp-related__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
    border-radius: var(--cp-radius-sm);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
  }
  .cp-related__icon :global(.cp-icon) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .cp-related__text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .cp-related__label {
    font-weight: 650;
    line-height: 1.3;
  }
  .cp-related__hint {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.4;
  }
</style>
