{
  "name": "cyberpatriot-practice-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Website for the CyberPatriot Practice Toolkit (Astro + Starlight, deployed on Cloudflare Pages)",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/sync-docs.mjs && astro check",
    "verify": "node scripts/verify-build.mjs",
    "test": "npm run build && npm run verify"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.3.5",
    "github-slugger": "2.0.0",
    "starlight-links-validator": "0.26.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
